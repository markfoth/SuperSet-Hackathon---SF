# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Frontend (Vite exposes only VITE_* variables, and they ARE visible in the browser) ---
# Base map tile URL template. Default is Stadia Maps Alidade Smooth, which works
# without a key on localhost. For a deployed site, create a free Stadia account and
# authorise the domain (no key in the URL needed), or use MapTiler with a
# domain-restricted key. CARTO's basemaps now return "API key required" tiles.
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=
# Commute polygons: "fixture" (default, no network) or "proxy" (live routing via `npm run proxy`,
# with offline fixtures as the fallback). For the dev server use VITE_ROUTING_PROXY_URL=/api.
VITE_COMMUTE_PROVIDER=fixture
VITE_ROUTING_PROXY_URL=

# --- Server-side / data pipeline only (never prefix with VITE_) ---
# 511.org Open Data token (free, https://511.org/open-data/token) — enables SamTrans and a CURRENT
# Muni timetable (SFMTA's public "current" feed expired 2026-08-28).
API_511_KEY=
# TravelTime free "Basic" plan (development/testing only — no paid plan). Sign up at
# https://account.traveltime.com/signup and paste the Application ID and API key. Read only by
# server/routing-proxy.mjs or api/isochrone.js on Vercel; never exposed to the browser.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=
ROUTING_PROXY_PORT=8787
# Max live TravelTime calls per day per running instance. Vercel instances do not share
# this counter; TravelTime account quotas still apply. Local results use data/cache/;
# the hosted function uses Vercel Runtime Cache.
ROUTING_DAILY_CAP=300
# Set to 1 to return the TravelTime request body instead of calling it (for checking set-up).
ROUTING_DRY_RUN=
# Dev/hackathon: which date timetables should cover (data pipeline). Defaults to 2026-10-22.
CG_SERVICE_DATE=
