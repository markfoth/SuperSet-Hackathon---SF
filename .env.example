# Copy to .env and fill in. .env is gitignored ; never commit real keys.

# --- Frontend (Vite exposes only VITE_* variables, and they ARE visible in the browser) ---
# Primary map: MapLibre with hosted OpenFreeMap vectors. No account or API key.
# Commute polygons: "fixture" (default, no network) or "proxy" (live routing via `npm run proxy`,
# with the offline example selected explicitly). For development use VITE_ROUTING_PROXY_URL=/api.
VITE_COMMUTE_PROVIDER=fixture
VITE_ROUTING_PROXY_URL=

# --- Server-side / data pipeline only (never prefix with VITE_) ---
# Optional 511.org token for original detailed Muni/data builders.
# Regional SamTrans, BART, Caltrain and VTA use verified public keyless feeds.
API_511_KEY=
# TravelTime free evaluation access (research/development/evaluation). Sign up at
# https://account.traveltime.com/signup and paste the Application ID and API key. Read only by
# server/routing-proxy.mjs or api/isochrone.js on Vercel; never exposed to the browser.
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=
ROUTING_PROXY_PORT=8787
# Max live TravelTime calls per day per running instance. Vercel instances do not share
# this counter; TravelTime account quotas still apply. Local results use data/cache/;
# hosted functions can use Vercel Runtime Cache when storage rights are verified.
ROUTING_DAILY_CAP=300
# Leave blank by default. Set to 1 only after verifying the provider account's
# contractual storage/caching rights. Enables the 24-hour persistent routing cache.
# Identical in-flight requests are deduplicated even when this is blank.
ROUTING_CACHE_ALLOWED=
# Set to 1 to return the TravelTime request body instead of calling it (for checking set-up).
ROUTING_DRY_RUN=
# Dev/hackathon: which date timetables should cover (data pipeline). Defaults to 2026-10-22.
CG_SERVICE_DATE=
